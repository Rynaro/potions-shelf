{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Rynaro/potions-shelf/schema/potion-manifest.schema.json",
  "title": "Potions Shelf catalog entry",
  "description": "Metadata for a Potions plugin hosted in a public GitHub repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "description", "author", "repository", "reviewed_commit"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,98}[a-z0-9])?$", "maxLength": 100},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "description": {"type": "string", "minLength": 10, "maxLength": 500},
    "author": {"type": "string", "minLength": 1, "maxLength": 100},
    "repository": {"type": "string", "maxLength": 255, "pattern": "^https://github\\.com/[A-Za-z0-9-]+/[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9])?(?:@v?(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?)?$"},
    "reviewed_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "homepage": {"type": "string", "format": "uri"},
    "license": {"type": "string", "minLength": 1, "maxLength": 100},
    "tags": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,49}$"}, "uniqueItems": true, "maxItems": 10},
    "min_potions_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "max_potions_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "potionfile_path": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[\\\\]).+$"},
    "dependencies": {"type": "array", "maxItems": 100, "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,98}[a-z0-9])?$"}, "version": {"type": "string", "pattern": "^(>=|<=|>|<|~>|=|\\^)(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"}}}, "uniqueItems": true}
  }
}
